# Copy to .env.storage in the project root. Never commit the actual file.
# Plain KEY=value (no quotes); read by backend and anticheating/app/run_service.py.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=exam-evidence
SUPABASE_STUDENT_PHOTOS_BUCKET=student-photos
# Server secret key; never use a publishable/anon key here or in frontend VITE_*.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Legacy service_role JWT is supported instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVER_SERVICE_ROLE_KEY
