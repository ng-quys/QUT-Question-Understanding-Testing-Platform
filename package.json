    "build:admin": "npm run build --workspace frontend-admin",
    "test:frontend": "npm run test --workspace frontend && npm run test --workspace frontend-admin"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "vite": "8.2.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "vite": "8.2.1"
  }
}
