{
  "dependencies": {
    "keycloak-js": "^26.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "name": "qut-platform",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend-admin",
    "frontend-shared"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace frontend",
