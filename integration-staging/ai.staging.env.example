# Template only. No credentials from Production. Do not pass this file as-is.
# The staging runner must build an isolated process environment and load this
# explicitly; PYTHON_DOTENV_DISABLED prevents main.py loading ai-service/.env.
PYTHON_DOTENV_DISABLED=1
AI_SAVED_DOCUMENTS_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_INTERNAL_KEY=REQUIRED_NEW_STAGING_ONLY_KEY
EXAMFLOW_QUESTIONBANK_DSN=host=127.0.0.1 port=55441 dbname=examflow_rag_staging user=examflow_rag_staging password='REQUIRED_STAGING_QB_PASSWORD' options='-c default_transaction_read_only=on'
EXAMFLOW_QUESTIONBANK_WRITER_DSN=host=127.0.0.1 port=55441 dbname=examflow_rag_staging user=examflow_rag_staging password='REQUIRED_STAGING_QB_PASSWORD'
AI_JOB_STATE_PATH=../.env.examflow.integration-staging/registry.json
AI_METRICS_XLSX_PATH=../.env.examflow.integration-staging/metrics.xlsx
AI_JOB_MAX_CONCURRENT=1
AI_CORS_ORIGINS=http://127.0.0.1:15173
